{
  "name": "ai-development-orchestrator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MCP bridge that lets a GPT project manager delegate repository work to a Claude-powered implementation agent.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "npm run build && node --test dist/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "@octokit/rest": "latest",
    "express": "latest",
    "simple-git": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
